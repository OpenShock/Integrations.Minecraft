{
	"schemaVersion": 1,
	"id": "${id}",
	"version": "${version}",
	"name": "${name}",
	"description": "${description}",
	"authors": [
		"Luc",
		"OpenShock Team"
	],
	"contact": {
		"homepage": "https://openshock.org/",
		"issues": "https://github.com/OpenShock/Integrations.Minecraft/issues",
		"sources": "https://github.com/OpenShock/Integrations.Minecraft"
	},
	"license": "GPL-3.0",
	"icon": "assets/${id}/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			{
				"value": "${group}.platform.FabricEntrypoint",
				"adapter": "kotlin"
			}
		],
		"modmenu": [
			{
				"value": "${group}.platform.ModMenuEntrypoint",
				"adapter": "kotlin"
			}
		]
	},
	"depends": {
		"minecraft": "${mcDepFabric}",
		"java": ">=${javaVersion}",
		"fabricloader": "*",
		"fabric-api": "*",
		"fabric-language-kotlin": ">=${fabricKotlinVersion}",
		"yet_another_config_lib_v3": "*",
		"modmenu": "*"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.discord": "https://discord.gg/OpenShock"
			}
		}
	}
}
